          "stringUnit": {
            "state": "translated",
            "value": "The shortcut is gone. Install it again to keep album playback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットが見つかりません。アルバムを続けて再生するには、もう一度追加してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {

          }
        }
      }
    },
    "relay_shortcut_confirming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Shortcuts asks whether to allow sharing, choose “Always Allow”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット App で共有を許可するか聞かれたら、「常に許可」を選んでください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果「捷徑」App 詢問是否允許分享，請選「永遠允許」。"
          }
        }
      }
    },
    "relay_shortcut_installed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcut installed. If Shortcuts asked about sharing, make sure you chose “Always Allow”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを追加しました。共有の許可を聞かれた場合は、「常に許可」を選んだか確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捷徑安裝完成。若「捷徑」App 問過是否允許分享，請確認選的是「永遠允許」。"
          }
        }
      }
    },
    "relay_shortcut_share_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Shortcuts asks again about sharing when you pick a song on iPad, choose “Always Allow”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad で曲を選んだときに、ショートカット App が共有の許可をもう一度聞いてきたら、「常に許可」を選んでください。"
          }

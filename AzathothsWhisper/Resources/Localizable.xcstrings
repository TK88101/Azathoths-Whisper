    "relay_unverified_request_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPad that just scanned the code wants to pair. Allow only if the 4 characters below match the ones on your iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを読み取った iPad がペアリングを求めています。下の 4 文字が iPad の表示と一致する場合のみ許可してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剛掃描的 iPad 正在請求配對。只有在下面 4 碼與 iPad 上顯示的一致時才允許。"
          }
        }
      }
    },
    "relay_unverified_request_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverified device request"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未確認のデバイスからのリクエスト"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未驗證的裝置請求"
          }
        }
      }
    },
    "relay_library_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Azathoth's Whisper can't read your Music library, so the iPad can't show your albums. Allow Azathoth's Whisper in System Settings › Privacy & Security › Media & Apple Music. If the iPad still can't load the library, quit and reopen Azathoth's Whisper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Azathoth's Whisper がミュージックライブラリを読み込めないため、iPad にアルバムを表示できません。システム設定 › プライバシーとセキュリティ › メディアと Apple Music で Azathoth's Whisper を許可してください。それでも iPad で読み込めない場合は、Azathoth's Whisper を終了して開き直してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Azathoth's Whisper 讀不到你的 Music 曲庫，iPad 無法顯示專輯。請到「系統設定 › 隱私權與安全性 › 媒體與 Apple Music」允許 Azathoth's Whisper。若 iPad 仍讀不到，請結束 Azathoth's Whisper 後重新打開。"
          }
        }
      }
    },
    "relay_open_media_privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Privacy Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシー設定を開く"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開隱私權設定"
          }
        }
      }
    },
    "relay_playback_section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Music Control"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージックの操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Music 控制"
          }
        }
      }
    },
    "relay_shortcut_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you pick a song on the iPad, Azathoth's Whisper runs the “YSE Play v1” shortcut so the rest of the album plays after it. Without the shortcut, only the song you picked plays."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad で曲を選ぶと、Azathoth's Whisper は「YSE Play v1」ショートカットを実行して、その曲のあとにアルバムの残りを続けて再生します。ショートカットがない場合は、選んだ曲だけが再生されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 點歌時，Azathoth's Whisper 會執行「YSE Play v1」捷徑，讓這首之後接著播專輯剩下的歌。沒有這個捷徑時，只會播你點的那一首。"
          }
        }
      }
    },
    "relay_music_not_authorized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac hasn't allowed Azathoth's Whisper to control Music, so the iPad's playback buttons won't work. Turn on Music for Azathoth's Whisper in System Settings › Privacy & Security › Automation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac は Azathoth's Whisper にミュージックの操作を許可していないため、iPad の再生ボタンは使えません。システム設定 › プライバシーとセキュリティ › オートメーションで、Azathoth's Whisper の「ミュージック」をオンにしてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 尚未允許 Azathoth's Whisper 控制 Music，iPad 上的播放按鈕暫時無法使用。請到「系統設定 › 隱私權與安全性 › 自動化」，在 Azathoth's Whisper 底下打開 Music。"
          }
        }
      }
    },
    "relay_open_automation_privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

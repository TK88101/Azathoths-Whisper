    "relay_shortcut_waiting_for_add": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Shortcuts app, click “Add Shortcut”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット App で「ショートカットを追加」をクリックしてください。"
          }
        },
        "zh-Hant": {

    "msg_fail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to write to iTunes. Track might be read-only (streaming) or app unreachable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iTunesへの書き込みに失敗しました。トラックが読み取り専用（ストリーミング）か、アプリに接続できません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入 iTunes 失敗。曲目可能是唯讀的 (串流) 或應用程序無法連接。"
          }
        }
      }

      }
    },
    "Can't reach your Mac. Make sure Remote Settings is on in Azathoth's Whisper." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Can't reach your Mac. Make sure Remote Settings is on in Azathoth's Whisper." } },
